      ".read": "auth != null",
      "$uid": {
        ".write": "auth != null && auth.uid === $uid"
      }
    },
    "sahaDavet": {
      "$uid": {
        ".read": "auth != null && auth.uid === $uid",
        "$from": {
          ".write": "auth != null && (auth.uid === $from || auth.uid === $uid)"
        }
      }
    },
    "sahaArkIstek": {
      "$uid": {
        ".read": "auth != null && auth.uid === $uid",
        "$from": {
          ".write": "auth != null && (auth.uid === $from || auth.uid === $uid)"
        }
      }
    },
    "sahaArkYanit": {
      "$uid": {
        ".read": "auth != null && auth.uid === $uid",
        "$from": {
          ".write": "auth != null && (auth.uid === $from || auth.uid === $uid)"
        }
      }
    },
    "sahaTransferAkis": {
      ".read": "auth != null",
      ".indexOn": [
        "ts"
      ],
      "$id": {
        ".write": "auth != null && !data.exists()",
        ".validate": "newData.hasChildren(['tur','oyuncu','tutar','ts'])"
      }
    },
    "sahaDuyuru": {
      ".read": "auth != null",
      ".indexOn": [
        "ts"
      ],
      "$id": {
        ".write": "root.child('admins').child(auth.uid).val() === true",
        ".validate": "newData.hasChildren(['baslik','metin','ts']) && newData.child('baslik').isString() && newData.child('baslik').val().length > 0 && newData.child('baslik').val().length <= 80 && newData.child('metin').isString() && newData.child('metin').val().length > 0 && newData.child('metin').val().length <= 1000 && newData.child('ts').isNumber() && newData.child('ts').val() <= now",
        "baslik": {
          ".validate": true
        },
        "metin": {
          ".validate": true
        },
        "ts": {
          ".validate": true
        },
        "$diger": {
          ".validate": false
        }
      }
    }
  }
}
